{
  "expo": {
    "name": "Clubvel",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/clubvel-community-favicon.png"
    },
    "slug": "clubvel",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/clubvel-community-icon.png",
    "scheme": "clubvel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "modjadji",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clubvel.clubvel",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload payment proof from your gallery",
        "NSCameraUsageDescription": "Take photos of payment receipts",
        "NSUserTrackingUsageDescription": "This allows Clubvel to show you relevant ads",
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.clubvel.clubvel",
      "googleServicesFile": "./google-services.json",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/clubvel-community-adaptive.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_SMS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/clubvel-community-splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/clubvel-community-splash.png",
            "imageWidth": 224,
            "backgroundColor": "#FFFFFF"
          },
          "dark": {
            "image": "./assets/images/clubvel-community-splash.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d5dc39d8-0b5e-4fbb-8b92-3e37e0863234"
      },
      "admob": {
        "androidAppId": "ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY",
        "iosAppId": "ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY",
        "note": "Replace with your actual AdMob App IDs when ready for production"
      }
    }
  }
}
